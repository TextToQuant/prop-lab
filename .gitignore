# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.pytest_cache
pytest-of-*/
.mypy_cache/
.ruff_cache/

# Data and generated artifacts — never commit these.
#
# The "data/" pattern below would match ANY directory called data at any
# depth, including the real src/prop_lab/data/ package. The negation
# after it re-includes that package. This is the standard git idiom for
# "ignore a directory name, except where it is a source package".
#
# The same trap applies to the file patterns below: a bare "*.csv"
# ignores every CSV anywhere, including an example dataset that belongs
# in the repository. The negations re-include the places where a data
# file is meant to be committed.
# "/data/" with a leading slash matches ONLY the root-level data
# directory. A bare "data/" would match any directory called data at any
# depth, and git cannot re-include a file whose parent directory is
# excluded, so the negation would never take effect.
/data/
*.csv
*.parquet
*.bi5
*.zip

# Re-include the places where a data file IS meant to be committed.
# Each directory is re-included before the files inside it, because the
# negation of a directory is what lets git look inside it at all.
!src/prop_lab/data/
!examples/data/
!examples/data/*.csv
!docs/**/*.csv
reports/
out/
*.png
!docs/images/*.png

# Editors
.vscode/
.idea/
.DS_Store

# Environment and secrets — never commit these.
.env
.env.*
!.env.example
*.pem
*.key

# Coverage and type-checking output
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytype/

# ----------------------------------------------------------------------
# Local work-session artifacts — never push these.
#
# These describe the machine and the session, not the package. They are
# deliberately ignored rather than deleted: the orchestration log is the
# running record of what was done and why, and it is useful locally.
# ----------------------------------------------------------------------
ORCHESTRATION.md
ORCHESTRATION*.md
TIMELINE*.md
NOTES*.md
WORKLOG*.md

# Local run output that escapes the reports/ and data/ rules.
*.log
logs/
tmp/
scratch/

# Notebook and editor working state
.ipynb_checkpoints/
.mplconfig/
.matplotlib/
